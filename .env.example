# Canonical production site URL — single source of truth used for
# metadata, sitemap, OAuth/reset-password redirects, email links, and
# webhook URLs (see lib/site-url.ts). Public because a few client
# components need it. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://fathirsthore.my.id

# Cloudflare Turnstile — CAPTCHA on register/login/forgot-password.
# Get both from https://dash.cloudflare.com > Turnstile > Add site.
# Site key is public (safe in the browser bundle); secret key is
# SERVER-ONLY and must never be exposed to the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Supabase project settings — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Auth > URL Configuration > Redirect URLs must include:
#   https://fathirsthore.my.id/auth/callback
#   http://localhost:3000/auth/callback (for local dev)

# Auth > Providers: enable and configure Google, GitHub, Discord
# with their client id/secret in the Supabase dashboard (not here —
# Supabase stores those, not your app's .env).

# Project Settings > API > service_role key.
# SERVER-ONLY — never expose this to the browser (no NEXT_PUBLIC_ prefix).
# Used to sign short-lived download URLs for the "scripts" storage bucket.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Pakasir (https://app.pakasir.com) — QRIS payments for premium scripts.
# Get these from your Project's detail page on Pakasir.
# SERVER-ONLY — never expose to the browser.
PAKASIR_PROJECT_SLUG=your-pakasir-project-slug
PAKASIR_API_KEY=your-pakasir-api-key
# In your Pakasir project settings, set Webhook URL to:
#   https://fathirsthore.my.id/api/payments/webhook

# Brevo (https://app.brevo.com) — transactional emails (purchase receipts,
# review/report notifications, security alerts). Different from the SMTP
# key used for Supabase Auth's own emails — this is a v3 API key from
# Brevo > SMTP & API > API Keys tab.
# SERVER-ONLY — never expose to the browser.
BREVO_API_KEY=your-brevo-v3-api-key

# Cloudflare R2 — file storage (scripts, thumbnails, screenshots, avatars,
# banners, documents). See docs/cloudflare-r2.md for the full setup guide.
# SERVER-ONLY — never expose R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY to the browser.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=fathirsthore
# Optional — only needed if you use a custom endpoint instead of the default
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Public base URL for the bucket (custom domain connected via R2 > Public
# Access in the Cloudflare dashboard — never the raw R2 API endpoint).
# Needed in BOTH forms: server code reads R2_PUBLIC_URL, and a few client
# components need the NEXT_PUBLIC_ variant to build a URL immediately after
# an upload, before the page re-fetches server data. Set both to the same value.
R2_PUBLIC_URL=https://cdn.fathirsthore.my.id
NEXT_PUBLIC_R2_PUBLIC_URL=https://cdn.fathirsthore.my.id

